PORT=3001
NODE_ENV=dev
DATABASE_URL="mongodb+srv://usuario:senha@cluster/devbills"

# Origens permitidas no CORS (separadas por vírgula). Vazio = qualquer origem
CORS_ORIGIN=http://localhost:5173

# Credenciais da Service Account do Firebase (Admin SDK)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENTE_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
